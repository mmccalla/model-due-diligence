# No secrets are required. Do not mount credentials when scanning untrusted models.

# model-due-diligence environment example
#
# These variables are optional defaults for the example scripts under examples/.
# The CLI itself uses command-line flags; see `mdd --help`.
#
# Keep this file as documentation only. Do not add real values here.

# Optional: override the default per-tool timeout used by example scripts.
# The CLI also supports: --timeout <seconds>
MDD_TIMEOUT_SECONDS=300

# Optional: default output directory used by example scripts.
# The CLI also supports: --out <directory>
MDD_OUTPUT_DIR=./model-audit-report

# Optional: set the fail threshold used by example scripts.
# Valid values: low, medium, high, critical
# The CLI also supports: --fail-on <level>
MDD_FAIL_ON=high

# Optional: scanner execution controls for example scripts.
# Use 1/true only when you intentionally want lighter or offline runs.
MDD_SKIP_EXTERNAL=false
MDD_QUALITY_SELF_CHECK=false

# Never add values such as:
# OPENAI_API_KEY=
# HF_TOKEN=
# HUGGINGFACE_TOKEN=
# GITHUB_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AZURE_CLIENT_SECRET=
# GOOGLE_APPLICATION_CREDENTIALS=
